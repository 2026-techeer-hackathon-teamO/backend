# 보안 담당자 알림용 Slack Incoming Webhook URL
SLACK_WEBHOOK_URL=

# 카나리토큰 비콘 수신 시 디코이 파일에 박아넣을 공개 베이스 URL
# 예: https://dlp.example.com  →  디코이가 열리면 {BASE}/api/canary/{token_id} 호출
CANARY_BASE_URL=http://localhost:8000

# agent 로그를 저장할 SQLite 파일 경로
DB_PATH=dlp.db

# 업로드된 디코이 파일 저장 폴더
DECOY_STORE_DIR=decoys_store

# 해킹 패턴 판단 AI(Claude). 비워두면 규칙 기반 분석만 사용
ANTHROPIC_API_KEY=
# 판단에 쓸 Claude 모델
AI_MODEL=claude-opus-5-5

# CORS 허용 오리진 (프론트 개발 서버)
CORS_ORIGINS=http://localhost:5173
